  "scientific_limits": {
    "en": "{\"inventory_ordinal\":382,\"name\":{\"en\":\"Kentrosaurus\",\"zh\":\"钉状龙\"},\"taxon\":\"Kentrosaurus aethiopicus\",\"classification\":\"Dinosauria, Ornithischia, Thyreophora, Stegosauridae\",\"representation\":\"living-reconstruction\",\"scope\":\"Original whole quadruped with anterior dorsal plates changing into long posterior spikes.\",\"scale\":{\"total_length_m\":5,\"basis\":\"NHM Dino Directory genus estimate, not exact measured length of composite MFN mount or femur specimen.\"},\"specimen_basis\":\"Mallison2014 original author photographs of MFN mounted composite skeleton and actual femur MB.R.3583 with tape measure. Mallison2011 text describes laser scans of tail lectotype MB.R.4800.6-32; no claim scan asset acquired.\",\"diagnostic_targets\":[\"Small low narrow head on visible neck; bulky arched trunk, short forelegs and taller hindlegs, four grounded feet.\",\"Paired dorsal armour: neck/anterior trunk relatively flattened small plates, transitioning posteriorly into long narrow projecting spikes.\",\"Long muscular tapering tail with several paired spikes rather than Stegosaurus only terminal thagomizer.\",\"Paired large lateral body spikes as reconstruction, place near shoulder following modern mount photograph, not a proven fossil life-position.\",\"No ankylosaur tailclub, no giant broad diamond plates continuing full back.\"],\"uncertainties\":[\"Composite skeletal mount includes restored skull and assembled individuals, not whole articulated fossil.\",\"Exact armour counts and placement unknown; lateral shoulder versus hip spike placement debated, shoulder choice explicitly reconstruction.\",\"Skin palette, soft tissue and keratin thickness inferred.\",\"5m genus estimate not specimen-specific; tape-measured femur photo illustrates bone, not whole-animal measurement.\"],\"profile\":\"palette-only static stylized reconstruction; local maker candidate, independent review pending\",\"palette\":{\"skin\":\"#6C7954\",\"dorsal\":\"#4C6043\",\"underside\":\"#AAA57B\",\"armour\":\"#C6AE7E\",\"horn\":\"#776247\",\"eye\":\"#20251D\"}}",
    "zh": "原创低多边形研究；形态、尺度及不确定性严格以本次已核参考为界。原始限定：{\"inventory_ordinal\":382,\"name\":{\"en\":\"Kentrosaurus\",\"zh\":\"钉状龙\"},\"taxon\":\"Kentrosaurus aethiopicus\",\"classification\":\"Dinosauria, Ornithischia, Thyreophora, Stegosauridae\",\"representation\":\"living-reconstruction\",\"scope\":\"Original whole quadruped with anterior dorsal plates changing into long posterior spikes.\",\"scale\":{\"total_length_m\":5,\"basis\":\"NHM Dino Directory genus estimate, not exact measured length of composite MFN mount or femur specimen.\"},\"specimen_basis\":\"Mallison2014 original author photographs of MFN mounted composite skeleton and actual femur MB.R.3583 with tape measure. Mallison2011 text describes laser scans of tail lectotype MB.R.4800.6-32; no claim scan asset acquired.\",\"diagnostic_targets\":[\"Small low narrow head on visible neck; bulky arched trunk, short forelegs and taller hindlegs, four grounded feet.\",\"Paired dorsal armour: neck/anterior trunk relatively flattened small plates, transitioning posteriorly into long narrow projecting spikes.\",\"Long muscular tapering tail with several paired spikes rather than Stegosaurus only terminal thagomizer.\",\"Paired large lateral body spikes as reconstruction, place near shoulder following modern mount photograph, not a proven fossil life-position.\",\"No ankylosaur tailclub, no giant broad diamond plates continuing full back.\"],\"uncertainties\":[\"Composite skeletal mount includes restored skull and assembled individuals, not whole articulated fossil.\",\"Exact armour counts and placement unknown; lateral shoulder versus hip spike placement debated, shoulder choice explicitly reconstruction.\",\"Skin palette, soft tissue and keratin thickness inferred.\",\"5m genus estimate not specimen-specific; tape-measured femur photo illustrates bone, not whole-animal measurement.\"],\"profile\":\"palette-only static stylized reconstruction; local maker candidate, independent review pending\",\"palette\":{\"skin\":\"#6C7954\",\"dorsal\":\"#4C6043\",\"underside\":\"#AAA57B\",\"armour\":\"#C6AE7E\",\"horn\":\"#776247\",\"eye\":\"#20251D\"}}"
  },
